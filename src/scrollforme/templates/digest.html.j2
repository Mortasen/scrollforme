<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>Digest {{ generated_at }}</title>
<style>
	:root { --bg: #fbfaf7; --text: #1d1d1b; --muted: #6b6a66; --rule: #e3e1db; --link: #1f4f8a; }
	@media (prefers-color-scheme: dark) {
		:root { --bg: #161615; --text: #e9e7e2; --muted: #9a9892; --rule: #2e2d2b; --link: #8fb4e8; }
	}
	body { background: var(--bg); color: var(--text); font: 17px/1.55 Georgia, serif; margin: 0; }
	main { max-width: 42rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
	header p, .meta, .notes, footer { color: var(--muted); font-size: 0.9rem; }
	section { border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1rem; }
	h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
	article { margin: 1.25rem 0; }
	h3 { font-size: 1.05rem; margin: 0; }
	a { color: var(--link); }
	.summary { margin: 0.25rem 0; }
	.error { color: #b3261e; }
	footer { border-top: 1px solid var(--rule); margin-top: 3rem; padding-top: 1rem; text-align: center; }
</style>
</head>
<body>
<main>
	<header>
		<h1>Your digest</h1>
		<p>{{ item_count }} items from {{ digests | length }} sources, collected {{ generated_at }}.</p>
	</header>
	{% for digest in digests %}
	<section>
		<h2><a href="{{ digest.source_url }}" rel="noreferrer">{{ digest.source_name }}</a></h2>
		{% if digest.error %}<p class="error">Could not read this source: {{ digest.error }}</p>{% endif %}
		{% if digest.notes %}<p class="notes">{{ digest.notes }}</p>{% endif %}
		{% for item in digest.items %}
		<article>
			<h3>{% if item.url %}<a href="{{ item.url }}" rel="noreferrer">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
			<p class="summary">{{ item.summary }}</p>
			{% if item.author or item.posted_at %}<p class="meta">{{ item.author }}{% if item.author and item.posted_at %} · {% endif %}{{ item.posted_at }}</p>{% endif %}
		</article>
		{% endfor %}
	</section>
	{% endfor %}
	<footer>That's everything. You're done.</footer>
</main>
</body>
</html>
